{
  "name": "@webhelpers/formula",
  "version": "0.2.0",
  "description": "Zero-configuration Reactive Forms using HTML5 form templates",
  "type": "module",
  "keywords": [
    "forms",
    "html5",
    "reactive",
    "nanostores"
  ],
  "license": "MIT",
  "author": {
    "name": "Tane Piper",
    "url": "https://tane.dev"
  },
  "homepage": "https://webhelpers.tools",
  "bugs": {
    "url": "https://github.com/web-helpers/formula/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/web-helpers/formula.git"
  },
  "dependencies": {
    "nanostores": ">=1.0.1"
  },
  "scripts": {
    "build": "vite build && tsc",
    "dev": "vite build --watch",
    "test": "playwright test"
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./webcomponent": {
      "types": "./types/src/lib/webcomponent/index.d.mts",
      "import": "./dist/src/lib/webcomponent/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "readme": "./README.md",
  "types": "./types/index.d.mts",
  "files": [
    "dist",
    "types",
    "README.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "vite": "^7.2.2"
  }
}
