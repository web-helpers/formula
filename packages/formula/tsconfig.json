{
  "extends": "../../tsconfig.json",
  "include": ["src/**/*", "index.mts"],
  "exclude": ["node_modules", "test-app", "tests", "src/**/*.spec.mjs", "src/**/*.spec.mts"],
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "baseUrl": ".",
    "checkJs": false,
    "allowJs": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./types",
    "emitDeclarationOnly": true
  }
}
